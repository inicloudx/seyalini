# Copy to .env (scripts/setup.sh does this). NEVER commit .env.
# Keep the real .env in Bitwarden as a secure note named "seyalini-env";
# setup.sh pulls it automatically on any new laptop.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DASHBOARD_URL=http://localhost:8000

# --- Database -------------------------------------------------------------
# Local Docker Postgres (default):
DATABASE_URL=postgres://seyalini:seyalini@db:5432/seyalini
# Shared across laptops (free tier, e.g. Neon): paste its URL instead
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/seyalini?sslmode=require
# Without Docker at all: DATABASE_URL=sqlite:///db.sqlite3

# --- Background jobs --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# 1 = run jobs inline (no Redis needed). Handy on a laptop without Docker.
CELERY_EAGER=0

# --- AI models ------------------------------------------------------------
# No key set = DRY RUN: agents use sample output and cost nothing.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Force dry run even with keys set:
LLM_DRY_RUN=0

# --- Telegram (approval notifications) --------------------------------------
# Create a bot with @BotFather, send it a message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
