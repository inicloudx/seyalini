{
  "name": "Seyalini",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "web",
  "runServices": ["db", "redis", "web", "worker", "beat"],
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "initializeCommand": "bash scripts/setup.sh --env-only",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django",
        "redhat.vscode-yaml"
      ]
    }
  }
}
