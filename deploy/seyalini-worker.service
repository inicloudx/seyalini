# /etc/systemd/system/seyalini-worker.service  - runs the agents (scripts, videos, uploads, analyst)
[Unit]
Description=Seyalini agents (celery worker)
After=network.target redis-server.service redis.service

[Service]
User=seyalini
Group=seyalini
WorkingDirectory=/opt/seyalini/app
EnvironmentFile=/opt/seyalini/app/.env
# concurrency 1: video rendering is heavy; one job at a time keeps the website fast
ExecStart=/opt/seyalini/venv/bin/celery -A config worker --loglevel=info --concurrency=1
Restart=always

[Install]
WantedBy=multi-user.target
