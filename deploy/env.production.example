# ~/seyalini/.env on the server. deploy.sh makes it and fills in the two secrets. NEVER commit the real file.
# (Comments only on their own lines: Docker would read a trailing "# ..." as part of the value.)
DJANGO_SECRET_KEY=change-me
# encrypts the keys saved in Settings; changing it = re-enter them
SEYALINI_ENCRYPTION_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=seyalini.inixr.com,127.0.0.1,localhost
DASHBOARD_URL=https://seyalini.inixr.com
CSRF_TRUSTED_ORIGINS=https://seyalini.inixr.com
# own subdomain, so no sub-path
URL_PREFIX=

# inside the containers (Docker volume seyalini_data): database, videos, tenants folder
DATABASE_URL=sqlite:////app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
TENANTS_DIR=/app/data/tenants

# jobs go through the small Redis container to the worker
REDIS_URL=redis://redis:6379/0
JOBS_MODE=celery
CELERY_EAGER=0
# Telegram replies and button taps are answered inside the web container (no second worker needed)
CHAT_JOBS_MODE=thread

# Small shared server (Earnly runs 24/7 here): the worker sleeps unless a job waits or a window is open.
# Windows are India time and cover the 06:00 Scout, 07:00 script, 14:00 script and 21:00 Analyst.
WORKER_SLEEPS=1
WORK_WINDOWS=05:50-07:30,13:50-14:30,20:50-21:20
WORKER_IDLE_MINUTES=15
# one ffmpeg thread: videos render slower but use much less memory
FFMPEG_THREADS=1

# INIXR uses this platform key (tenant.yaml use_platform_keys: true). Other organisations add theirs in Settings.
GEMINI_API_KEY=
LLM_DRY_RUN=0
ALLOW_SIGNUP=0
