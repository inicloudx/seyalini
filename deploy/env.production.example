# /opt/seyalini/app/.env on the server. NEVER commit the real file.
# No comments after values in this file (systemd reads it). Generate the secret with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(50))"   and keep a copy in your password manager
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=seyalini.inixr.com
# Own subdomain, so no sub-path. (Set URL_PREFIX=seyalini only if served at inixr.com/seyalini.)
URL_PREFIX=
CSRF_TRUSTED_ORIGINS=https://seyalini.inixr.com
DASHBOARD_URL=https://seyalini.inixr.com

# SQLite is fine for one company; switch to Postgres when there are many organisations
DATABASE_URL=sqlite:////opt/seyalini/data/db.sqlite3
MEDIA_ROOT=/opt/seyalini/data/media

REDIS_URL=redis://127.0.0.1:6379/0
JOBS_MODE=celery
CELERY_EAGER=0

# The server's own ffmpeg (setup.sh installs it; works on ARM and x86)
IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg

# INIXR uses the platform key (tenant.yaml use_platform_keys: true). Other orgs add theirs in Settings.
GEMINI_API_KEY=
LLM_DRY_RUN=0
ALLOW_SIGNUP=0

# Encrypts the API keys stored in the database. If this changes, saved keys stop working.
# Use the SAME value as DJANGO_SECRET_KEY on the laptop you set keys from, or set a fixed one:
SEYALINI_ENCRYPTION_KEY=
