# /etc/systemd/system/seyalini-beat.service  - the company clock (7 AM script, 2 PM script, 9 PM analyst; India time)
[Unit]
Description=Seyalini schedule (celery beat)
After=network.target redis-server.service redis.service

[Service]
User=seyalini
Group=seyalini
WorkingDirectory=/opt/seyalini/app
EnvironmentFile=/opt/seyalini/app/.env
ExecStart=/opt/seyalini/venv/bin/celery -A config beat --loglevel=info --schedule=/opt/seyalini/data/celerybeat-schedule
Restart=always

[Install]
WantedBy=multi-user.target
